# Local dev (direct API port)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# Firebase Authentication (Google Sign-In on web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=foodapp-17385.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=foodapp-17385

# Production behind Nginx (use in root .env for docker build)
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_WS_URL=

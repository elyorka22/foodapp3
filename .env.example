# Database
POSTGRES_USER=foodapp
POSTGRES_PASSWORD=foodapp_secret_change_me
POSTGRES_DB=foodapp

# API
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://foodapp:foodapp_secret_change_me@postgres:5432/foodapp?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://yourdomain.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
TRUST_PROXY_HOPS=1
BRUTE_FORCE_MAX_ATTEMPTS=10
BRUTE_FORCE_LOCK_TTL=900

# DigitalOcean Spaces (required in production)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=your-space-name
SPACES_ACCESS_KEY=your-access-key
SPACES_SECRET_KEY=your-secret-key
SPACES_CDN_URL=https://your-space-name.nyc3.cdn.digitaloceanspaces.com

# Local uploads (migration only — not used by API after Spaces cutover)
UPLOAD_DIR=./uploads

# Frontend (build args)
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=

# Database
POSTGRES_USER=foodapp
POSTGRES_PASSWORD=foodapp_secret_change_me
POSTGRES_DB=foodapp

# API
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://foodapp:foodapp_secret_change_me@postgres:5432/foodapp?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=/uploads

# Frontend (build args)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=http://localhost

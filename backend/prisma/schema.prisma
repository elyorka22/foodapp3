generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  BUSINESS
  COURIER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  COURIER_ASSIGNED
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum NotificationType {
  ORDER_UPDATE
  COURIER_ASSIGN
  SYSTEM
  SMS_READY
}

enum CustomerAuthProvider {
  TELEGRAM
  PHONE
}

enum BusinessApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// How customers interact with businesses of this vertical.
enum BusinessCatalogMode {
  CATALOG
  CONTACT
}

enum DeliveryProviderType {
  INTERNAL
  COURIER_NETWORK
  TAXI
  THIRD_PARTY
}

enum AdminNotificationType {
  NEW_ORDER
  COURIER_OFFLINE
  RESTAURANT_SUSPENDED
  CUSTOMER_BLOCKED
}

enum PromoCodeType {
  FIXED
  PERCENTAGE
}

enum LoyaltyLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?   @map("password_hash")
  fullName     String?   @map("full_name")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  businessStaff BusinessStaff[]
  managerProfile  Manager?
  courierProfile  Courier?
  notifications   Notification[]
  orderStatusChanges OrderStatusHistory[]
  auditLogs          AuditLog[]
  adminNotificationReads AdminNotificationRead[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model BusinessType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  icon             String?
  imageUrl         String?  @map("image_url")
  imageScale       Int      @default(100) @map("image_scale")
  imagePositionX   Int      @default(50) @map("image_position_x")
  imagePositionY   Int      @default(50) @map("image_position_y")
  catalogMode      BusinessCatalogMode @default(CATALOG) @map("catalog_mode")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businesses Business[]

  @@index([isActive, sortOrder])
  @@map("business_types")
}

/// Universal merchant (restaurant, grocery, flower shop, etc.). DB table: restaurants.
model Business {
  id              String    @id @default(uuid()) @db.Uuid
  businessTypeId  String?   @map("business_type_id") @db.Uuid
  name            String
  slug            String    @unique
  description     String?
  logoUrl         String?   @map("logo_url")
  coverUrl        String?   @map("cover_url")
  coverPositionX  Int       @default(50) @map("cover_position_x")
  coverPositionY  Int       @default(50) @map("cover_position_y")
  phone           String?
  email           String?
  commissionRate  Decimal               @default(10) @map("commission_rate") @db.Decimal(5, 2)
  isActive        Boolean               @default(true) @map("is_active")
  approvalStatus  BusinessApprovalStatus @default(APPROVED) @map("approval_status")
  approvalNote    String?               @map("approval_note")
  approvedAt      DateTime?             @map("approved_at")
  minOrderAmount  Decimal?              @map("min_order_amount") @db.Decimal(10, 2)
  avgPrepMinutes  Int                   @default(30) @map("avg_prep_minutes")
  averageRating   Decimal?              @default(4.5) @map("average_rating") @db.Decimal(3, 2)
  reviewCount     Int                   @default(0) @map("review_count")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  businessType       BusinessType?           @relation(fields: [businessTypeId], references: [id])
  branches           BusinessBranch[]
  productCategories  ProductCategory[]
  products           Product[]
  staff              BusinessStaff[]
  orders             Order[]
  banners            Banner[]
  workingHours       BusinessWorkingHours[]
  holidays           BusinessHoliday[]

  @@index([isActive, deletedAt])
  @@index([approvalStatus])
  @@index([businessTypeId])
  @@map("restaurants")
}

model BusinessBranch {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("restaurant_id") @db.Uuid
  name       String
  address    String
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  phone      String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id])
  orders   Order[]

  @@index([businessId])
  @@map("restaurant_branches")
}

model BusinessStaff {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  businessId String    @map("restaurant_id") @db.Uuid
  position   String?
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("restaurant_staff")
}

model Manager {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  zone      String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("managers")
}

model Courier {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  vehicleType     String?   @map("vehicle_type")
  isOnline        Boolean   @default(false) @map("is_online")
  currentLat      Decimal?  @map("current_lat") @db.Decimal(10, 7)
  currentLng      Decimal?  @map("current_lng") @db.Decimal(10, 7)
  totalDeliveries Int       @default(0) @map("total_deliveries")
  totalEarnings   Decimal   @default(0) @map("total_earnings") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user        User                 @relation(fields: [userId], references: [id])
  assignments CourierAssignment[]
  orders      Order[]

  @@index([isOnline, deletedAt])
  @@map("couriers")
}

/// Per-business product menu category (Fruits, Drinks, etc.). NOT a business vertical type.
model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("restaurant_id") @db.Uuid
  name        String
  slug        String
  description String?
  icon        String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@map("categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @map("restaurant_id") @db.Uuid
  productCategoryId String?   @map("category_id") @db.Uuid
  name              String
  slug              String
  description       String?
  price             Decimal   @db.Decimal(10, 2)
  comparePrice      Decimal?  @map("compare_price") @db.Decimal(10, 2)
  isAvailable       Boolean   @default(true) @map("is_available")
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  business         Business         @relation(fields: [businessId], references: [id])
  productCategory  ProductCategory? @relation(fields: [productCategoryId], references: [id])
  images           ProductImage[]
  orderItems       OrderItem[]
  cartItems        CartItem[]

  @@unique([businessId, slug])
  @@index([businessId, isAvailable])
  @@index([productCategoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

enum BannerPlacement {
  HERO
  PROMO
}

model Banner {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String?         @map("restaurant_id") @db.Uuid
  title        String          @default("")
  description  String?
  imageUrl     String          @map("image_url")
  linkUrl      String?         @map("link_url")
  placement    BannerPlacement @default(HERO) @map("placement")
  sortOrder    Int             @default(0) @map("sort_order")
  isActive     Boolean         @default(true) @map("is_active")
  startsAt     DateTime?       @map("starts_at")
  endsAt       DateTime?       @map("ends_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  deletedAt    DateTime?       @map("deleted_at")

  business Business? @relation(fields: [businessId], references: [id])

  @@index([isActive, placement])
  @@map("banners")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  sessionId String     @unique @map("session_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String?   @unique
  fullName     String    @map("full_name")
  email        String?
  isActive     Boolean   @default(true) @map("is_active")
  passwordHash String?   @map("password_hash")
  otpVerified  Boolean   @default(false) @map("otp_verified")
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  telegramId          BigInt?               @unique @map("telegram_id")
  telegramUsername    String?               @map("telegram_username")
  telegramFirstName   String?               @map("telegram_first_name")
  telegramLastName    String?               @map("telegram_last_name")
  telegramPhotoUrl    String?               @map("telegram_photo_url")
  authProvider        CustomerAuthProvider? @map("auth_provider")
  isTelegramVerified  Boolean               @default(false) @map("is_telegram_verified")
  lastTelegramLoginAt DateTime?             @map("last_telegram_login_at")

  defaultDeliveryAddress String?  @map("default_delivery_address")
  defaultLatitude        Decimal? @map("default_latitude") @db.Decimal(10, 7)
  defaultLongitude       Decimal? @map("default_longitude") @db.Decimal(10, 7)

  referralCode   String?  @unique @map("referral_code")
  guestOrders    GuestOrder[]
  loyalty        CustomerLoyalty?
  promoUsages    PromoCodeUsage[]
  referralsSent  Referral[] @relation("ReferralInviter")
  referralsGot   Referral[] @relation("ReferralInvited")

  @@index([deletedAt])
  @@index([telegramUsername])
  @@map("customers")
}

model GuestOrder {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  phone           String
  deliveryAddress String   @map("delivery_address")
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  comment         String?
  otpVerified     Boolean  @default(false) @map("otp_verified")
  otpCode         String?  @map("otp_code")
  otpExpiresAt    DateTime? @map("otp_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([phone])
  @@index([customerId])
  @@map("guest_orders")
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  orderNumber           String               @unique @map("order_number")
  trackingToken         String               @unique @map("tracking_token")
  businessId            String               @map("restaurant_id") @db.Uuid
  branchId              String?              @map("branch_id") @db.Uuid
  guestOrderId          String               @map("guest_order_id") @db.Uuid
  courierId             String?              @map("courier_id") @db.Uuid
  deliveryProviderType  DeliveryProviderType @default(INTERNAL) @map("delivery_provider_type")
  externalDeliveryRef   String?              @map("external_delivery_ref")
  status                OrderStatus          @default(PENDING)
  subtotal         Decimal     @db.Decimal(10, 2)
  deliveryFee      Decimal     @map("delivery_fee") @db.Decimal(10, 2)
  commissionAmount Decimal     @default(0) @map("commission_amount") @db.Decimal(10, 2)
  discountAmount   Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  promoCodeId      String?     @map("promo_code_id") @db.Uuid
  total            Decimal     @db.Decimal(10, 2)
  distanceKm       Decimal?    @map("distance_km") @db.Decimal(8, 2)
  cancelReason     String?     @map("cancel_reason")
  estimatedMinutes Int?        @map("estimated_minutes")
  acceptedAt       DateTime?   @map("accepted_at")
  deliveredAt      DateTime?   @map("delivered_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  business    Business        @relation(fields: [businessId], references: [id])
  branch      BusinessBranch? @relation(fields: [branchId], references: [id])
  guestOrder  GuestOrder        @relation(fields: [guestOrderId], references: [id])
  courier     Courier?          @relation(fields: [courierId], references: [id])
  items       OrderItem[]
  payment     Payment?
  assignment  CourierAssignment?
  address     Address?
  transactions   Transaction[]
  statusHistory  OrderStatusHistory[]
  promoCode      PromoCode?         @relation(fields: [promoCodeId], references: [id])
  promoUsage     PromoCodeUsage?

  @@index([businessId, status])
  @@index([promoCodeId])
  @@index([status, createdAt])
  @@index([courierId])
  @@index([trackingToken])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @unique @map("order_id") @db.Uuid
  line1     String
  line2     String?
  city      String?
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  notes     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model CourierAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  courierId   String    @map("courier_id") @db.Uuid
  assignedBy  String?   @map("assigned_by") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  pickedUpAt  DateTime? @map("picked_up_at")
  deliveredAt DateTime? @map("delivered_at")
  courierFee  Decimal   @map("courier_fee") @db.Decimal(10, 2)
  distanceKm  Decimal   @map("distance_km") @db.Decimal(8, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  courier Courier @relation(fields: [courierId], references: [id])

  @@index([courierId])
  @@map("courier_assignments")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @unique @map("order_id") @db.Uuid
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("transactions")
}

model DeliveryZone {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  polygon       Json
  baseFee       Decimal  @map("base_fee") @db.Decimal(10, 2)
  pricePerKm    Decimal  @map("price_per_km") @db.Decimal(10, 2)
  minDeliveryFee Decimal @map("min_delivery_fee") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  orderId   String?          @map("order_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model OrderStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  status          OrderStatus
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminNotification {
  id        String                @id @default(uuid()) @db.Uuid
  type      AdminNotificationType
  title     String
  body      String
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at")

  reads AdminNotificationRead[]

  @@index([createdAt])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("admin_notification_reads")
}

model PromoCode {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique
  type              PromoCodeType
  value             Decimal        @db.Decimal(10, 2)
  minimumOrderAmount Decimal?      @map("minimum_order_amount") @db.Decimal(10, 2)
  maximumDiscount   Decimal?       @map("maximum_discount") @db.Decimal(10, 2)
  usageLimit        Int?           @map("usage_limit")
  usageCount        Int            @default(0) @map("usage_count")
  startsAt          DateTime?      @map("starts_at")
  expiresAt         DateTime?      @map("expires_at")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  orders  Order[]
  usages  PromoCodeUsage[]

  @@index([isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([promoCodeId])
  @@index([customerId])
  @@map("promo_code_usages")
}

model BusinessWorkingHours {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("restaurant_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  openTime   String   @map("open_time")
  closeTime  String   @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("restaurant_working_hours")
}

model BusinessHoliday {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("restaurant_id") @db.Uuid
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("restaurant_holidays")
}

model CustomerLoyalty {
  id         String       @id @default(uuid()) @db.Uuid
  customerId String       @unique @map("customer_id") @db.Uuid
  points     Int          @default(0)
  level      LoyaltyLevel @default(BRONZE)
  updatedAt  DateTime     @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_loyalty")
}

model Referral {
  id                 String   @id @default(uuid()) @db.Uuid
  inviterCustomerId  String   @map("inviter_customer_id") @db.Uuid
  invitedCustomerId  String   @unique @map("invited_customer_id") @db.Uuid
  rewardPoints       Int      @default(0) @map("reward_points")
  rewardedAt         DateTime? @map("rewarded_at")
  createdAt          DateTime @default(now()) @map("created_at")

  inviter Customer @relation("ReferralInviter", fields: [inviterCustomerId], references: [id])
  invited Customer @relation("ReferralInvited", fields: [invitedCustomerId], references: [id])

  @@index([inviterCustomerId])
  @@map("referrals")
}

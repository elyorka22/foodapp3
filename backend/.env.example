NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://foodapp:foodapp_secret@localhost:5432/foodapp?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Telegram Login Widget + Bot API (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret path segment for POST /api/v1/telegram-bot/webhook/:secret
TELEGRAM_WEBHOOK_SECRET=
# Public API base URL for webhook setup (e.g. https://api.foodapp.uz)
API_PUBLIC_URL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

THROTTLE_TTL=60000
THROTTLE_LIMIT=400

# DigitalOcean Spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=your-space-name
SPACES_ACCESS_KEY=your-access-key
SPACES_SECRET_KEY=your-secret-key
SPACES_CDN_URL=https://your-space-name.nyc3.cdn.digitaloceanspaces.com

# Local folder for migrate-local-images.ts only
UPLOAD_DIR=./uploads

# Firebase Admin (required for POST /auth/google; also used when PUSH_PROVIDER=firebase)
# FIREBASE_PROJECT_ID=foodapp-17385
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or mount a service account file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Push delivery (FCM transport — FoodApp owns notification logic)
PUSH_PROVIDER=noop
# Enable FCM: PUSH_PROVIDER=firebase
